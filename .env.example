# ─── Apify (Instagram scraping) ─────────────────────────────────────────────
# Get your token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_token_here

# ─── Anthropic (Claude AI) ──────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from https://app.supabase.com/project/_/settings/api
# Run schema.sql in the SQL editor first to create tables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # never expose in browser
SUPABASE_ANON_KEY=your_anon_key_here              # safe for browser use

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...   # from Stripe → Developers → Webhooks
# Optional: pre-created Stripe Price IDs (if blank, checkout uses inline price_data)
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...
